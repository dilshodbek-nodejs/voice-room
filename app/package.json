{
  "name": "voice-room-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend:install": "npm --prefix backend ci",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "server": "node backend/dist/server.js",
    "start": "npm run build && npm --prefix backend run build && node backend/dist/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "livekit-client": "^2.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
