# ---- HTTP ----
PORT=2021

# ---- Auth (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# SFU token lifetime (seconds) — голосовая сессия без переподключения
SFU_TOKEN_TTL=21600

# ---- Postgres ----
DATABASE_URL=postgres://voice:voice@localhost:5432/voice_room

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- LiveKit SFU ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret
# Public URL handed to browsers (wss through nginx in prod)
LIVEKIT_PUBLIC_URL=

# ---- Room defaults ----
ROOM_MAX_PEERS=10
ROOM_DEFAULT_OPEN_MIC=true

# ---- Rate limits ----
JOIN_RATE_PER_MIN=10
CHAT_THROTTLE_MS=1000
REACT_COOLDOWN_MS=10000
